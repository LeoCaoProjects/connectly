# Local database started with docker compose from the repository root.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/connectly
SPRING_DATASOURCE_USERNAME=connectly
SPRING_DATASOURCE_PASSWORD=local-dev-only

# Optional: portfolio suggestions.
GROQ_API_KEY=

# Email verification requires a key authorised for the sender in OtpService.java.
SENDGRID_API_KEY=
